# Server Port
PORT=3601

# HOSxP Read-Only Database Connection
HOSXP_HOST=192.168.2.254
HOSXP_PORT=3306
HOSXP_USER=opd
HOSXP_PASSWORD=YOUR_HOSXP_PASSWORD
HOSXP_DB=hos

# ThaID OpenID Connect v2 (DOPA)
THAID_CALLBACK_URL=http://147.50.107.211:3601/
THAID_API_KEY=YOUR_THAID_API_KEY
THAID_CLIENT_ID=YOUR_THAID_CLIENT_ID
THAID_CLIENT_SECRET=YOUR_THAID_CLIENT_SECRET
THAID_AUTH_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/auth/
THAID_TOKEN_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/token/
THAID_USERINFO_URL=https://imauth.bora.dopa.go.th/api/v2/oauth2/userinfo/
THAID_SCOPE=openid pid given_name middle_name family_name

# Staff Passcode for Unit / Package Administration
